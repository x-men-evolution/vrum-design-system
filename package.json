{
  "name": "vrum-design-system",
  "private": true,
  "packageManager": "npm@11.4.2",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "tokens:build": "turbo run build --filter=@x-men-evolution/design-tokens"
  },
  "devDependencies": {
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "turbo": "^2.5.4",
    "typescript-eslint": "^8.64.0"
  }
}
